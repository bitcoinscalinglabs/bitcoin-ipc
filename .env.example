# Bitcoin Core RPC

RPC_USER=user
RPC_PASS=pass
RPC_URL=http://127.0.0.1:18443
WALLET_NAME=validator1

# Validator

VALIDATOR_SK_PATH=/Users/user/.ipc/validator1/validator.sk
# EOTS secret key (hex) of one subnet, the one whose join carries it; its sign record is kept next
# to it as <file>.votes.db. Unset: a join-ue generates the key of each subnet as eots.<txid20>.sk
# next to the validator key.
EOTS_SK_PATH=/Users/user/.ipc/validator1/eots.sk
# EOTS nonce seed (32 random bytes, hex), kept as secret as the key; required with EOTS_SK_PATH.
# Unset: eots.<txid20>.seed next to the validator key, generated with the key.
EOTS_SEED_PATH=/Users/user/.ipc/validator1/eots.seed

# Provider + Monitor

DATABASE_URL=<HOME_DIR>/.ipc/validator1/regtest_db

# Provider

PROVIDER_PORT=3030
PROVIDER_AUTH_TOKEN=validator1_auth_token

# Monitor

MONITOR_POLL_INTERVAL=2
# Blocks fetched per batched RPC round-trip during sync.
# Higher value cuts round-trips but uses more memory per batch.
MONITOR_SYNC_BATCH_SIZE=1000

# General

RUST_LOG=bitcoin_ipc=debug,monitor=debug,provider=debug,bitcoincore_rpc=error,actix_web=info

# Reward variables for Emission Chain

ACTIVATION_HEIGHT=0
SNAPSHOT_LENGTH=10

# Unilateral exit: Bitcoin height from which join-ue is processed, unset = off. The full node
# must serve any transaction by its txid.
# UE_ACTIVATION_HEIGHT=0