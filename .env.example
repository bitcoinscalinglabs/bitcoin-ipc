# Bitcoin Core RPC

RPC_USER=user
RPC_PASS=pass
RPC_URL=http://127.0.0.1:18443
WALLET_NAME=validator1

# Validator

VALIDATOR_SK_PATH=/Users/user/.ipc/validator1/validator.sk
# The EOTS secret key (hex), for the votes that make subnet blocks final; its sign record is
# kept next to it as <file>.votes.db
EOTS_SK_PATH=/Users/user/.ipc/validator1/eots.sk
# The seed (32 random bytes, hex) of every EOTS nonce the key commits to: as secret as the key,
# since one nonce and its vote give the key; required with EOTS_SK_PATH
EOTS_SEED_PATH=/Users/user/.ipc/validator1/eots.seed

# Provider + Monitor

DATABASE_URL=<HOME_DIR>/.ipc/validator1/regtest_db

# Provider

PROVIDER_PORT=3030
PROVIDER_AUTH_TOKEN=validator1_auth_token

# Monitor

MONITOR_POLL_INTERVAL=2
# Blocks fetched per batched RPC round-trip during sync.
# Higher value cuts round-trips but uses more memory per batch.
MONITOR_SYNC_BATCH_SIZE=1000

# General

RUST_LOG=bitcoin_ipc=debug,monitor=debug,provider=debug,bitcoincore_rpc=error,actix_web=info

# Reward variables for Emission Chain

ACTIVATION_HEIGHT=0
SNAPSHOT_LENGTH=10

# Unilateral exit: Bitcoin height from which join-ue is processed; unset = off. The monitor
# reads a join-ue's commit transaction from the reveal's block, or through bitcoind's -txindex
# when it was mined earlier.
# UE_ACTIVATION_HEIGHT=0